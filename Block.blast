import pygame
import random

# Block Blast Game Implementation

# Constants
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
BLOCK_SIZE = 50
FPS = 60

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)

# Initialize Pygame
pygame.init()

# Create the screen
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption('Block Blast')

clock = pygame.time.Clock()

# Game variables
score = 0
blocks = []
for i in range(5):
    x = random.randint(0, SCREEN_WIDTH - BLOCK_SIZE)
    y = random.randint(0, SCREEN_HEIGHT - BLOCK_SIZE)
    blocks.append(pygame.Rect(x, y, BLOCK_SIZE, BLOCK_SIZE))

# Game Loop
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Fill the screen with white
    screen.fill(WHITE)

    # Draw blocks
    for block in blocks:
        pygame.draw.rect(screen, GREEN, block)

    pygame.display.flip()
    clock.tick(FPS)

pygame.quit()