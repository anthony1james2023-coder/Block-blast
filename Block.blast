import pygame
import random
import sys
from enum import Enum

# ============================================================================
# BLOCK BLAST GAME - ADVENTURE CLASSIC MODE
# ============================================================================

pygame.init()

# CONSTANTS AND CONFIGURATION
SCREEN_WIDTH = 1000
SCREEN_HEIGHT = 700
FPS = 60
GRID_SIZE = 50
GRID_WIDTH = 10
GRID_HEIGHT = 10
GRID_OFFSET_X = 80
GRID_OFFSET_Y = 120
MINIMUM_MATCH = 3
SCORE_PER_BLOCK = 100
COMBO_MULTIPLIER = 1.5

# COLOR PALETTE
COLOR_WHITE = (255, 255, 255)
COLOR_BLACK = (0, 0, 0)
COLOR_RED = (255, 80, 80)
COLOR_GREEN = (80, 255, 80)
COLOR_BLUE = (80, 150, 255)
COLOR_YELLOW = (255, 255, 80)
COLOR_PURPLE = (200, 80, 255)
COLOR_ORANGE = (255, 165, 80)
COLOR_CYAN = (80, 255, 255)
COLOR_PINK = (255, 105, 180)
COLOR_BROWN = (165, 42, 42)
COLOR_GRAY = (128, 128, 128)
COLOR_DARK_GRAY = (64, 64, 64)
COLOR_DARK_BLUE = (25, 25, 112)

BLOCK_COLORS = [COLOR_RED, COLOR_GREEN, COLOR_BLUE, COLOR_YELLOW, COLOR_PURPLE, COLOR_ORANGE, COLOR_CYAN, COLOR_PINK]

# ENUMERATIONS
class GameMode(Enum):
    ADVENTURE = "adventure"
    CLASSIC = "classic"
    SURVIVAL = "survival"

class GameState(Enum):
    MENU = "menu"
    MODE_SELECT = "mode_select"
    PLAYING = "playing"
    PAUSED = "paused"
    LEVEL_COMPLETE = "level_complete"
    GAME_OVER = "game_over"

# DATA CLASSES
class Block:
    def __init__(self, x, y, color, block_type="normal"):
        self.x = x
        self.y = y
        self.color = color
        self.block_type = block_type
        self.is_matched = False
        self.opacity = 1.0

class Level:
    def __init__(self, level_number, target_score, time_limit=None, grid_width=GRID_WIDTH, grid_height=GRID_HEIGHT, num_colors=4, difficulty=1.0, description="", background_color=COLOR_DARK_BLUE):
        self.level_number = level_number
        self.target_score = target_score
        self.time_limit = time_limit
        self.grid_width = grid_width
        self.grid_height = grid_height
        self.num_colors = num_colors
        self.difficulty = difficulty
        self.description = description
        self.background_color = background_color

# UTILITY FUNCTIONS
def get_font(size):
    return pygame.font.Font(None, size)

def draw_text(surface, text, font, color, x, y, center=False):
    text_surface = font.render(text, True, color)
    text_rect = text_surface.get_rect()
    if center:
        text_rect.center = (x, y)
    else:
        text_rect.topleft = (x, y)
    surface.blit(text_surface, text_rect)

def draw_button(surface, text, x, y, width, height, font, bg_color, text_color, hover=False):
    if hover:
        button_color = tuple(min(c + 30, 255) for c in bg_color)
    else:
        button_color = bg_color
    rect = pygame.Rect(x, y, width, height)
    pygame.draw.rect(surface, button_color, rect)
    pygame.draw.rect(surface, COLOR_WHITE, rect, 3)
    draw_text(surface, text, font, text_color, x + width // 2, y + height // 2, center=True)
    return rect

# BLOCK GRID MANAGEMENT
class BlockGrid:
    def __init__(self, width=GRID_WIDTH, height=GRID_HEIGHT, num_colors=4):
        self.width = width
        self.height = height
        self.num_colors = min(num_colors, len(BLOCK_COLORS))
        self.grid = []
        self.selected = set()
        self._initialize_grid()
    
    def _initialize_grid(self):
        self.grid = []
        for y in range(self.height):
            row = []
            for x in range(self.width):
                color = random.choice(BLOCK_COLORS[:self.num_colors])
                block = Block(x=x, y=y, color=color)
                row.append(block)
            self.grid.append(row)
    
    def get_block(self, x, y):
        if 0 <= x < self.width and 0 <= y < self.height:
            return self.grid[y][x]
        return None
    
    def get_neighbors(self, x, y):
        neighbors = []
        center = self.get_block(x, y)
        if not center:
            return neighbors
        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:
            nx, ny = x + dx, y + dy
            neighbor = self.get_block(nx, ny)
            if neighbor and neighbor.color == center.color:
                neighbors.append((nx, ny))
        return neighbors
    
    def find_matches(self):
        visited = set()
        matches = []
        for y in range(self.height):
            for x in range(self.width):
                if (x, y) not in visited:
                    block = self.get_block(x, y)
                    if block:
                        group = self._bfs_group(x, y, visited)
                        if len(group) >= MINIMUM_MATCH:
                            matches.append(group)
        return matches
    
    def _bfs_group(self, start_x, start_y, visited):
        group = []
        queue = [(start_x, start_y)]
        while queue:
            x, y = queue.pop(0)
            if (x, y) in visited:
                continue
            visited.add((x, y))
            group.append((x, y))
            for nx, ny in self.get_neighbors(x, y):
                if (nx, ny) not in visited:
                    queue.append((nx, ny))
        return group
    
    def eliminate_blocks(self, positions):
        for x, y in positions:
            self.grid[y][x] = None
        score = len(positions) * SCORE_PER_BLOCK
        self.apply_gravity()
        return score
    
    def apply_gravity(self):
        for x in range(self.width):
            blocks = [self.grid[y][x] for y in range(self.height) if self.grid[y][x] is not None]
            for y in range(self.height):
                self.grid[y][x] = None
            start_y = self.height - len(blocks)
            for i, block in enumerate(blocks):
                block.y = start_y + i
                self.grid[start_y + i][x] = block
        for y in range(self.height):
            for x in range(self.width):
                if self.grid[y][x] is None:
                    color = random.choice(BLOCK_COLORS[:self.num_colors])
                    self.grid[y][x] = Block(x=x, y=y, color=color)

# LEVEL MANAGEMENT
class LevelManager:
    def __init__(self):
        self.levels = self._create_levels()
        self.current_level = 0
    
    def _create_levels(self):
        return [
            Level(1, 1000, None, 8, 8, 3, 1.0, "Beginner - Learn the basics"),
            Level(2, 2000, 120, 8, 8, 4, 1.2, "Intermediate - Timed challenge"),
            Level(3, 3500, 90, 10, 10, 5, 1.5, "Advanced - More blocks, less time"),
            Level(4, 5000, 120, 10, 10, 6, 1.8, "Expert - Master the game"),
            Level(5, 7500, 180, 10, 10, 7, 2.0, "Legend - The ultimate test"),
            Level(6, 10000, 300, 12, 12, 8, 2.5, "Impossible - For true masters"),
        ]
    
    def get_current_level(self):
        if self.current_level < len(self.levels):
            return self.levels[self.current_level]
        return self.levels[-1]
    
    def next_level(self):
        if self.current_level < len(self.levels) - 1:
            self.current_level += 1
    
    def reset(self):
        self.current_level = 0

# GAME ENGINE
class GameEngine:
    def __init__(self, display):
        self.display = display
        self.clock = pygame.time.Clock()
        self.state = GameState.MENU
        self.game_mode = None
        self.running = True
        self.score = 0
        self.combo = 0
        self.time_elapsed = 0
        self.grid = None
        self.level_manager = LevelManager()
        self.selected_blocks = set()
        self.hovering_block = None
    
    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            elif event.type == pygame.MOUSEBUTTONDOWN:
                self._handle_click(event.pos)
            elif event.type == pygame.MOUSEMOTION:
                self._handle_motion(event.pos)
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    if self.state == GameState.PLAYING:
                        self.state = GameState.PAUSED
                    elif self.state == GameState.PAUSED:
                        self.state = GameState.PLAYING
                    else:
                        self.state = GameState.MENU
                elif event.key == pygame.K_SPACE:
                    if self.state in [GameState.MENU, GameState.MODE_SELECT]:
                        self.state = GameState.MODE_SELECT
                    elif self.state == GameState.LEVEL_COMPLETE:
                        self.level_manager.next_level()
                        self.start_game()
                    elif self.state == GameState.GAME_OVER:
                        self.state = GameState.MENU
    
    def _handle_click(self, pos):
        if self.state == GameState.MENU:
            if 350 <= pos[0] <= 650 and 300 <= pos[1] <= 380:
                self.state = GameState.MODE_SELECT
        elif self.state == GameState.MODE_SELECT:
            if 100 <= pos[0] <= 400 and 250 <= pos[1] <= 350:
                self.game_mode = GameMode.ADVENTURE
                self.start_game()
            elif 600 <= pos[0] <= 900 and 250 <= pos[1] <= 350:
                self.game_mode = GameMode.CLASSIC
                self.start_game()
        elif self.state == GameState.PLAYING:
            grid_x = (pos[0] - GRID_OFFSET_X) // GRID_SIZE
            grid_y = (pos[1] - GRID_OFFSET_Y) // GRID_SIZE
            if 0 <= grid_x < self.grid.width and 0 <= grid_y < self.grid.height:
                self._select_block(grid_x, grid_y)
    
    def _handle_motion(self, pos):
        grid_x = (pos[0] - GRID_OFFSET_X) // GRID_SIZE
        grid_y = (pos[1] - GRID_OFFSET_Y) // GRID_SIZE
        if 0 <= grid_x < self.grid.width and 0 <= grid_y < self.grid.height:
            self.hovering_block = (grid_x, grid_y)
        else:
            self.hovering_block = None
    
    def _select_block(self, x, y):
        block = self.grid.get_block(x, y)
        if not block:
            return
        if (x, y) in self.selected_blocks:
            self.selected_blocks.remove((x, y))
            return
        if self.selected_blocks:
            selected_color = self.grid.get_block(list(self.selected_blocks)[0][0], list(self.selected_blocks)[0][1]).color
            if block.color != selected_color:
                self.selected_blocks.clear()
                self.selected_blocks.add((x, y))
                return
            can_select = False
            for sx, sy in self.selected_blocks:
                if (x, y) in self.grid.get_neighbors(sx, sy):
                    can_select = True
                    break
            if can_select:
                self.selected_blocks.add((x, y))
            else:
                self.selected_blocks.clear()
        else:
            self.selected_blocks.add((x, y))
        if len(self.selected_blocks) >= MINIMUM_MATCH:
            self._eliminate_selected()
    
    def _eliminate_selected(self):
        if not self.selected_blocks:
            return
        score = self.grid.eliminate_blocks(list(self.selected_blocks))
        score = int(score * (1 + self.combo * 0.1))
        self.score += score
        self.combo += 1
        self.selected_blocks.clear()
        level = self.level_manager.get_current_level()
        if self.score >= level.target_score:
            self.state = GameState.LEVEL_COMPLETE
    
    def start_game(self):
        level = self.level_manager.get_current_level()
        self.grid = BlockGrid(level.grid_width, level.grid_height, level.num_colors)
        self.score = 0
        self.combo = 0
        self.time_elapsed = 0
        self.selected_blocks = set()
        self.state = GameState.PLAYING
    
    def update(self, delta_time):
        if self.state == GameState.PLAYING:
            self.time_elapsed += delta_time
            level = self.level_manager.get_current_level()
            if level.time_limit and self.time_elapsed > level.time_limit:
                self.state = GameState.GAME_OVER
    
    def render(self):
        if self.state == GameState.MENU:
            self._render_menu()
        elif self.state == GameState.MODE_SELECT:
            self._render_mode_select()
        elif self.state == GameState.PLAYING:
            self._render_game()
        elif self.state == GameState.PAUSED:
            self._render_paused()
        elif self.state == GameState.LEVEL_COMPLETE:
            self._render_level_complete()
        elif self.state == GameState.GAME_OVER:
            self._render_game_over()
        pygame.display.flip()
    
    def _render_menu(self):
        self.display.fill(COLOR_DARK_BLUE)
        title_font = get_font(80)
        subtitle_font = get_font(40)
        button_font = get_font(32)
        draw_text(self.display, "BLOCK BLAST", title_font, COLOR_CYAN, SCREEN_WIDTH // 2, 80, center=True)
        draw_text(self.display, "Puzzle Game Adventure", subtitle_font, COLOR_YELLOW, SCREEN_WIDTH // 2, 180, center=True)
        draw_button(self.display, "START GAME", 350, 300, 300, 80, button_font, COLOR_GREEN, COLOR_BLACK)
        draw_text(self.display, "Press SPACE or Click START", get_font(24), COLOR_WHITE, SCREEN_WIDTH // 2, 480, center=True)
    
    def _render_mode_select(self):
        self.display.fill(COLOR_DARK_BLUE)
        title_font = get_font(60)
        mode_font = get_font(36)
        draw_text(self.display, "SELECT GAME MODE", title_font, COLOR_CYAN, SCREEN_WIDTH // 2, 50, center=True)
        draw_button(self.display, "ADVENTURE MODE", 100, 250, 300, 100, mode_font, COLOR_BLUE, COLOR_WHITE)
        draw_text(self.display, "Multiple levels with progression", get_font(20), COLOR_WHITE, 250, 380, center=True)
        draw_button(self.display, "CLASSIC MODE", 600, 250, 300, 100, mode_font, COLOR_ORANGE, COLOR_WHITE)
        draw_text(self.display, "Endless gameplay - How high can you score?", get_font(20), COLOR_WHITE, 750, 380, center=True)
        draw_text(self.display, "Press ESC to go back", get_font(20), COLOR_YELLOW, SCREEN_WIDTH // 2, 600, center=True)
    
    def _render_game(self):
        level = self.level_manager.get_current_level()
        self.display.fill(level.background_color)
        grid_rect = pygame.Rect(GRID_OFFSET_X, GRID_OFFSET_Y, self.grid.width * GRID_SIZE, self.grid.height * GRID_SIZE)
        pygame.draw.rect(self.display, COLOR_DARK_GRAY, grid_rect)
        pygame.draw.rect(self.display, COLOR_WHITE, grid_rect, 3)
        for y in range(self.grid.height):
            for x in range(self.grid.width):
                block = self.grid.get_block(x, y)
                if block:
                    screen_x = GRID_OFFSET_X + x * GRID_SIZE
                    screen_y = GRID_OFFSET_Y + y * GRID_SIZE
                    block_rect = pygame.Rect(screen_x + 2, screen_y + 2, GRID_SIZE - 4, GRID_SIZE - 4)
                    pygame.draw.rect(self.display, block.color, block_rect)
                    pygame.draw.rect(self.display, COLOR_WHITE, block_rect, 2)
                    if (x, y) in self.selected_blocks:
                        pygame.draw.rect(self.display, COLOR_YELLOW, block_rect, 4)
                    if (x, y) == self.hovering_block:
                        pygame.draw.circle(self.display, COLOR_WHITE, (screen_x + GRID_SIZE // 2, screen_y + GRID_SIZE // 2), GRID_SIZE // 3, 2)
        ui_font_large = get_font(32)
        ui_font_small = get_font(24)
        draw_text(self.display, f"Score: {self.score}", ui_font_large, COLOR_GREEN, 20, 20)
        draw_text(self.display, f"Level: {level.level_number}", ui_font_large, COLOR_CYAN, 20, 60)
        draw_text(self.display, f"Target: {level.target_score}", ui_font_small, COLOR_WHITE, SCREEN_WIDTH - 220, 20)
        draw_text(self.display, f"Time: {int(self.time_elapsed)}s", ui_font_small, COLOR_WHITE, SCREEN_WIDTH - 220, 60)
        if self.combo > 1:
            draw_text(self.display, f"Combo x{self.combo}", ui_font_large, COLOR_YELLOW, SCREEN_WIDTH // 2, 20, center=True)
        draw_text(self.display, "ESC: Pause | Click blocks to match", get_font(16), COLOR_GRAY, 20, SCREEN_HEIGHT - 20)
    
    def _render_paused(self):
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT))
        overlay.set_alpha(128)
        overlay.fill(COLOR_BLACK)
        self.display.blit(overlay, (0, 0))
        pause_font = get_font(72)
        text_font = get_font(36)
        draw_text(self.display, "PAUSED", pause_font, COLOR_YELLOW, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 100, center=True)
        draw_text(self.display, "Press ESC to Resume", text_font, COLOR_WHITE, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 50, center=True)
    
    def _render_level_complete(self):
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT))
        overlay.set_alpha(200)
        overlay.fill(COLOR_BLACK)
        self.display.blit(overlay, (0, 0))
        complete_font = get_font(64)
        score_font = get_font(48)
        text_font = get_font(32)
        draw_text(self.display, "LEVEL COMPLETE!", complete_font, COLOR_GREEN, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 150, center=True)
        draw_text(self.display, f"Score: {self.score}", score_font, COLOR_YELLOW, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2, center=True)
        draw_text(self.display, "Press SPACE for next level", text_font, COLOR_WHITE, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 100, center=True)
    
    def _render_game_over(self):
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT))
        overlay.set_alpha(200)
        overlay.fill(COLOR_BLACK)
        self.display.blit(overlay, (0, 0))
        gameover_font = get_font(64)
        score_font = get_font(48)
        text_font = get_font(32)
        draw_text(self.display, "GAME OVER", gameover_font, COLOR_RED, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 150, center=True)
        draw_text(self.display, f"Final Score: {self.score}", score_font, COLOR_YELLOW, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2, center=True)
        draw_text(self.display, "Press SPACE to return to menu", text_font, COLOR_WHITE, SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 100, center=True)
    
    def run(self):
        while self.running:
            delta_time = self.clock.tick(FPS) / 1000.0
            self.handle_events()
            self.update(delta_time)
            self.render()
        pygame.quit()
        sys.exit()

# MAIN ENTRY POINT
if __name__ == "__main__":
    display = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
    pygame.display.set_caption("Block Blast - Adventure Classic")
    engine = GameEngine(display)
    engine.run()