# Class for the block grid system
class BlockGrid:
    def __init__(self):
        self.grid = [[0 for _ in range(SCREEN_WIDTH // BLOCK_SIZE)] for _ in range(SCREEN_HEIGHT // BLOCK_SIZE)]

    def reset_grid(self):
